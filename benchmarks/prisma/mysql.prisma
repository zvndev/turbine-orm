generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma-mysql"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "mysql"
}

model Organization {
  id        BigInt   @id @default(autoincrement())
  name      String @db.Text
  slug      String   @unique @db.VarChar(191)
  plan      String   @default("free") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  users     User[]
  posts     Post[]

  @@map("organizations")
}

model User {
  id          BigInt    @id @default(autoincrement())
  orgId       BigInt    @map("org_id")
  email       String    @unique @db.VarChar(191)
  name        String @db.Text
  role        String    @default("member") @db.Text
  avatarUrl   String?   @map("avatar_url") @db.Text
  lastLoginAt DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  organization Organization @relation(fields: [orgId], references: [id])
  posts        Post[]
  comments     Comment[]

  @@index([orgId])
  @@map("users")
}

model Post {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  orgId     BigInt   @map("org_id")
  title     String @db.Text
  content   String @db.Text
  published Boolean  @default(false)
  viewCount Int      @default(0) @map("view_count")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.DateTime(3)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])
  comments     Comment[]
  postTags     PostTag[]

  @@index([userId])
  @@index([orgId])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model Comment {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt   @map("post_id")
  userId    BigInt   @map("user_id")
  body      String @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

model Tag {
  id   BigInt @id @default(autoincrement())
  name String @unique @db.VarChar(191)
  slug String @unique @db.VarChar(191)

  postTags PostTag[]

  @@map("tags")
}

model PostTag {
  postId BigInt @map("post_id")
  tagId  BigInt @map("tag_id")

  post Post @relation(fields: [postId], references: [id])
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model BenchWide {
  id BigInt @id @default(autoincrement())
  t01 String @db.Text
  t02 String @db.Text
  t03 String @db.Text
  t04 String @db.Text
  t05 String @db.Text
  t06 String @db.Text
  t07 String @db.Text
  t08 String @db.Text
  t09 String @db.Text
  t10 String @db.Text
  t11 String @db.Text
  t12 String @db.Text
  t13 String @db.Text
  t14 String @db.Text
  t15 String @db.Text
  t16 String @db.Text
  t17 String @db.Text
  t18 String @db.Text
  t19 String @db.Text
  t20 String @db.Text
  n01 Int
  n02 Int
  n03 Int
  n04 Int
  n05 Int
  n06 Int
  n07 Int
  n08 Int
  n09 Int
  n10 Int
  b01 Boolean
  b02 Boolean
  b03 Boolean
  b04 Boolean
  b05 Boolean
  d01 DateTime @db.DateTime(3)
  d02 DateTime @db.DateTime(3)
  d03 DateTime @db.DateTime(3)

  @@map("bench_wide")
}

model BenchWrite {
  id        BigInt   @id @default(autoincrement())
  orgId     BigInt   @map("org_id")
  slug      String   @unique @db.VarChar(191)
  label     String @db.Text
  amount    Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([orgId])
  @@map("bench_writes")
}
